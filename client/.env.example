# Production: https://your-backend.onrender.com
VITE_BACKEND_URL=http://localhost:5000

# Application Branding & Metadata
VITE_APP_NAME=GreenProof AI
VITE_APP_TAGLINE=Evidence-Based Environmental Claim Assessment
