# ==============================================================================
# GreenProof AI - Comprehensive Git Ignore Rules
# Protects secrets, credentials, builds, dependencies, and uploaded evidence
# ==============================================================================

# 1. Environment Variables & Secret Keys (CRITICAL)
.env
.env.*
!.env.example
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 2. Dependency Directories
node_modules/
*/node_modules/
jspm_packages/
web_modules/

# 3. Production Builds & Compiled Assets
dist/
dist-ssr/
build/
out/
.vercel/
*.tsbuildinfo

# 4. User Uploads & Evidence Storage (Confidential User Data)
uploads/
server/uploads/
server/uploads/images/*
server/uploads/evidence/*
!server/uploads/.gitkeep
!server/uploads/images/.gitkeep
!server/uploads/evidence/.gitkeep
temp/
tmp/
temp_test_*

# 5. Database Caches & In-Memory MongoDB Binaries
.mongodb-binaries/
mongodb-memory-server/
*.sqlite
*.sqlite3
*.db
dump/

# 6. Logs & Debug Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 7. Testing & Code Coverage
coverage/
.nyc_output/
*.lcov
test-results/

# 8. Operating System System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/

# 9. IDE & Editor Artifacts
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo

# 10. Cache Directories
.cache/
.vite/
.eslintcache
.parcel-cache
.turbo/
