# Backend Environment Variables (Keep confidential, do not commit .env)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/greenproof?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
CLIENT_URL=http://localhost:5173
