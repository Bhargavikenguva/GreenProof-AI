# ==============================================================================
# GreenProof AI - Backend Standalone .gitignore
# ==============================================================================

# Secrets & Environment Variables (CRITICAL)
.env
.env.*
!.env.example
*.env
.env.local

# Node Dependencies
node_modules/

# User Uploads & Confidential Documents
uploads/
uploads/images/*
uploads/evidence/*
!uploads/.gitkeep
!uploads/images/.gitkeep
!uploads/evidence/.gitkeep
temp/
tmp/
temp_test_*

# Database & In-Memory Binaries
.mongodb-binaries/
mongodb-memory-server/
*.sqlite
*.sqlite3
*.db
dump/

# Logs & Debug Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test Coverage
coverage/
.nyc_output/

# OS & Editor Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?
