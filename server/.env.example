# ==============================================================================
# GREENPROOF AI - BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or In-Memory Local)
# Leave blank for local in-memory DB or provide your MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/greenproof?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# Google Gemini API (@google/genai)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Allowed Frontend Origin(s)
CLIENT_URL=http://localhost:5173
